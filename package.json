{
  "name": "jarvis-core",
  "version": "0.0.0",
  "private": true,
  "description": "Jarvis — Personal Operating System. Noyau local-first.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "jarvis": "tsx --env-file-if-exists=.env src/apps/cli/main.ts",
    "jarvis:web": "tsx --env-file-if-exists=.env src/apps/server/main.ts",
    "jarvis:setup": "tsx --env-file-if-exists=.env ops/setup.ts",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='src/**' --coverage.reporter=text --coverage.reporter=html",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:security": "vitest run tests/security",
    "test:policy": "vitest run tests/policy",
    "test:memory": "vitest run tests/memory",
    "test:context": "vitest run tests/context",
    "test:undo": "vitest run tests/undo",
    "test:tools": "vitest run tests/tools",
    "test:quarantine": "vitest run tests/quarantine",
    "test:intent": "vitest run tests/intent",
    "test:server": "vitest run tests/server",
    "test:redteam": "vitest run tests/redteam",
    "test:lab": "vitest run tests/lab",
    "db:bootstrap": "tsx --env-file-if-exists=.env ops/db/bootstrap.ts",
    "db:migrate": "tsx --env-file-if-exists=.env ops/db/migrate.ts up",
    "db:rollback": "tsx --env-file-if-exists=.env ops/db/migrate.ts down",
    "db:status": "tsx --env-file-if-exists=.env ops/db/migrate.ts status",
    "secrets:scan": "tsx ops/security/scan-secrets.ts",
    "gate:phase0": "tsx --env-file-if-exists=.env ops/gates/phase0.ts",
    "gate:phase1": "tsx --env-file-if-exists=.env ops/gates/phase1.ts",
    "gate:phase2": "tsx --env-file-if-exists=.env ops/gates/phase2.ts",
    "gate:phase3": "tsx --env-file-if-exists=.env ops/gates/phase3.ts",
    "gate:phase7": "tsx --env-file-if-exists=.env ops/gates/phase7.ts",
    "bench": "tsx --env-file-if-exists=.env ops/bench/run.ts"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.12.0",
    "pg": "8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.36.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vitest": "3.2.4"
  }
}
