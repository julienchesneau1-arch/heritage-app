{
  "name": "jarvis-core",
  "version": "0.0.0",
  "private": true,
  "description": "Jarvis — Personal Operating System. Noyau local-first.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:security": "vitest run tests/security",
    "test:policy": "vitest run tests/policy",
    "test:memory": "vitest run tests/memory",
    "test:context": "vitest run tests/context",
    "test:undo": "vitest run tests/undo",
    "test:tools": "vitest run tests/tools",
    "test:quarantine": "vitest run tests/quarantine",
    "db:bootstrap": "tsx ops/db/bootstrap.ts",
    "db:migrate": "tsx ops/db/migrate.ts up",
    "db:rollback": "tsx ops/db/migrate.ts down",
    "db:status": "tsx ops/db/migrate.ts status",
    "secrets:scan": "tsx ops/security/scan-secrets.ts",
    "gate:phase0": "tsx ops/gates/phase0.ts",
    "gate:phase1": "tsx ops/gates/phase1.ts",
    "gate:phase2": "tsx ops/gates/phase2.ts",
    "bench": "tsx ops/bench/run.ts"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.12.0",
    "pg": "8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "eslint": "9.36.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vitest": "3.2.4"
  }
}
