// Héritage — schéma de données.
// Source de vérité : HERITAGE_SPEC.md §2. Aucune table ne peut être ajoutée
// sans mise à jour de ce document.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── FAMILLE ───
model Family {
  id        String   @id @default(cuid())
  name      String

  // Le lien familial est le secret d'accès (§4.1). Les liens PERSONNELS se
  // révoquent déjà par `Member.tokenVersion` ; celui-ci n'avait aucun
  // équivalent. Une famille qui publiait son lien par erreur n'avait aucun
  // recours. L'incrémenter invalide l'ancien lien pour tout le monde —
  // c'est brutal, et c'est exactement ce qu'on veut dans ce cas-là.
  tokenVersion Int @default(1) @map("token_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members        Member[]
  stories        Story[]
  archives       Archive[]
  traditions     Tradition[]
  threads        Thread[]
  messages       Message[]
  entities       Entity[]
  passages       Passage[]
  visibilityLogs VisibilityLog[]

  @@map("families")
}

// ─── MEMBRE (utilisateur au sens familial) ───
model Member {
  id         String    @id @default(cuid())
  familyId   String    @map("family_id")
  name       String
  birthDate  DateTime? @map("birth_date")
  deathDate  DateTime? @map("death_date")
  generation Int
  role       String?
  email      String?
  avatarUrl  String?   @map("avatar_url")

  // §2.1 règle 1 : la suppression d'un membre est un soft-delete.
  // Les histoires restent, l'auteur devient "Auteur anonymisé".
  isDeleted Boolean @default(false) @map("is_deleted")

  // Révocation : incrémenter invalide le lien personnel de CE membre,
  // sans déconnecter le reste de la famille.
  tokenVersion Int @default(1) @map("token_version")

  // Ne pas figurer au calendrier familial.
  //
  // Le flux .ics est recopié chez Google ou Apple. Quelqu'un peut vouloir
  // appartenir à la mémoire de sa famille SANS que sa date de naissance
  // parte chez un tiers. C'est le « retirer mes mots » de l'Annexe A
  // point 6, appliqué à ce qui SORT. Le défaut reste l'inclusion : on ne
  // retire personne de sa famille sans qu'il l'ait demandé.
  calendarOptOut Boolean @default(false) @map("calendar_opt_out")

  createdAt DateTime @default(now()) @map("created_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  storiesAuthored  Story[]        @relation("Author")
  storiesNarrated  Story[]        @relation("Narrator")
  entities         Entity[]
  messagesWritten  Message[]      @relation("MessageAuthor")
  messagesNarrated Message[]      @relation("MessageNarrator")
  threadsOpened    Thread[]       @relation("ThreadOpener")
  messageMarks     MessageMark[]
  archivesUploaded Archive[]
  mutedStories     StoryMute[]

  transcriptionsRequested TranscriptionDraft[] @relation("Requester")
  transcriptionsValidated TranscriptionDraft[] @relation("Validator")

  @@index([familyId])
  @@map("members")
}

// ─── RÉCIT (le cœur du produit) ───
model Story {
  id       String @id @default(cuid())
  familyId String @map("family_id")

  // Qui a SAISI le récit. Presque toujours quelqu'un qui sait taper.
  authorId String @map("author_id")

  // Qui l'a RACONTÉ, quand ce n'est pas la même personne.
  // Sans ce champ, une aïeule de 92 ans qui ne tape pas disparaît de sa
  // propre mémoire familiale : tout ce qu'elle transmet est attribué à
  // celui qui tenait le clavier. Nullable — la plupart des récits sont
  // saisis par celui qui les raconte.
  narratorId String? @map("narrator_id")

  title   String
  content String // texte brut, max 5000 caractères (contrainte applicative, cf. lib/validation.ts)

  // Grammaire narrative : structure imposée par le système, jamais inventée par le LLM.
  // Valeurs autorisées : cf. src/lib/structure-types.ts (33 types, annexe B).
  structureType String @map("structure_type")

  // Titre + contenu normalisés (sans accent, sans ponctuation) : la
  // recherche doit trouver « demenagement » quand on a écrit « déménagement ».
  searchText String @default("") @map("search_text")

  tone   String // intime, factuel, epique
  length String // micro (<300c), standard (<1500c), long (<5000c)

  // Conservateur
  views            Int       @default(0)
  lastViewedAt     DateTime? @map("last_viewed_at")
  quarantined      Boolean   @default(false)
  quarantineReason String?   @map("quarantine_reason")
  archived         Boolean   @default(false)

  // Métadonnées temporelles
  createdAt DateTime  @default(now()) @map("created_at")
  eventDate DateTime? @map("event_date") // date de l'événement raconté, pas de la création

  family   Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author   Member  @relation("Author", fields: [authorId], references: [id])
  narrator Member? @relation("Narrator", fields: [narratorId], references: [id])

  linkedEntities Entity[]  @relation("StoryEntities")
  archives       Archive[]
  threads        Thread[]  @relation("ThreadOnStory")
  bornFromThread Thread?   @relation("ThreadCrystallized")

  // Passages (chaînes de transmission)
  parentPassages Passage[] @relation("ParentStory")
  childPassages  Passage[] @relation("ChildStory")

  visibilityLogs VisibilityLog[]
  mutes          StoryMute[]

  // Provenance : ce récit vient-il d'une transcription, et qui l'a vérifiée ?
  transcriptionDraft TranscriptionDraft?

  @@index([familyId, createdAt])
  @@map("stories")
}

// ─── ENTITÉ (nœud du graphe : personne, lieu, objet, date, concept) ───
model Entity {
  id             String  @id @default(cuid())
  familyId       String  @map("family_id")
  type           String // PERSON, PLACE, OBJECT, DATE, CONCEPT
  name           String
  normalizedName String  @map("normalized_name") // lowercase, sans accent, sans ponctuation
  description    String?

  // Pour les personnes : lien optionnel vers Member
  memberId String? @map("member_id")

  createdAt DateTime @default(now()) @map("created_at")

  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id])
  stories Story[] @relation("StoryEntities")
  threads Thread[]

  @@unique([familyId, normalizedName, type])
  @@map("entities")
}

// ─── ARCHIVE (photo, document, audio, vidéo) ───
model Archive {
  id         String  @id @default(cuid())
  familyId   String  @map("family_id")
  uploaderId String  @map("uploader_id")
  storyId    String? @map("story_id")

  type       String // PHOTO, DOCUMENT, AUDIO, VIDEO
  title      String
  storageKey String @map("storage_key")
  mimeType   String @map("mime_type")
  sizeBytes  Int    @map("size_bytes")

  // Métadonnées extraites (par LLM ou manuel)
  extractedText     String?  @map("extracted_text")
  extractedEntities String[] @map("extracted_entities")

  createdAt DateTime @default(now()) @map("created_at")

  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploader Member @relation(fields: [uploaderId], references: [id])
  story    Story? @relation(fields: [storyId], references: [id])

  transcriptionDraft TranscriptionDraft?
  messages           Message[]

  @@index([familyId])
  @@map("archives")
}

// ─── TRADITION (rituel cyclique) ───
model Tradition {
  id          String  @id @default(cuid())
  familyId    String  @map("family_id")
  name        String
  description String
  periodicity String // annual, monthly, weekly
  monthDay    String? @map("month_day") // "10-15" pour annual
  weekDay     Int?    @map("week_day") // 0-6 pour weekly

  lastActivatedAt DateTime? @map("last_activated_at")
  activationCount Int       @default(0) @map("activation_count")
  isAsleep        Boolean   @default(false) @map("is_asleep")
  sleepReason     String?   @map("sleep_reason")

  createdAt DateTime @default(now()) @map("created_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("traditions")
}

// ─── CONVERSATION (Q&A autour d'un récit) ───
// ─── LE FIL ───
//
// Le modèle `Conversation` qu'il remplace était une question et UNE réponse,
// obligatoirement accrochée à un récit déjà écrit. Deux verrous en un :
// personne ne pouvait parler avant que quelqu'un ait rédigé, et personne ne
// pouvait répondre à une réponse. La page blanche gardait l'entrée, et le
// troisième intervenant n'avait pas de place.
//
// Un fil se rattache à une ENTITÉ (la maison de Bordeaux, la montre de
// Robert), à un RÉCIT, ou à rien du tout — une question en l'air. Au plus un
// point d'ancrage : la contrainte est posée en SQL, pas seulement promise.
model Thread {
  id       String  @id @default(cuid())
  familyId String  @map("family_id")
  entityId String? @map("entity_id")
  storyId  String? @map("story_id")

  // La plupart des fils n'ont pas de titre : on parle de la montre, c'est
  // tout. Il n'est demandé nulle part.
  title String?

  openedById String @map("opened_by_id")

  // Cristallisation : le récit né de ce fil. Le fil ne disparaît pas — il
  // devient la provenance, et le récit peut citer qui a dit quoi.
  crystallizedStoryId String? @unique @map("crystallized_story_id")

  // Dénormalisés pour ordonner et pour repérer un fil resté sans réponse
  // sans compter les messages à chaque affichage. `lastMessageAt` sert à
  // TRIER, jamais à afficher « inactif depuis trois semaines » : le fil
  // montre ce qu'il contient, jamais ce qui lui manque.
  messageCount  Int      @default(0) @map("message_count")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  createdAt DateTime @default(now()) @map("created_at")

  family             Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  // `Cascade` détruisait la parole des autres. Vérifié sur les données
  // réelles : Claire supprimait son récit, et la question qu'Emma avait
  // posée dessous disparaissait — Emma n'ayant rien décidé, ni été
  // prévenue. L'Annexe A point 6 fait de la suppression une décision de
  // celui à qui les mots appartiennent ; une cascade la donnait à un tiers.
  //
  // Le fil se DÉTACHE désormais. Il perd son ancrage, il garde sa parole.
  entity             Entity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)
  story              Story?    @relation("ThreadOnStory", fields: [storyId], references: [id], onDelete: SetNull)
  crystallizedStory  Story?    @relation("ThreadCrystallized", fields: [crystallizedStoryId], references: [id])
  openedBy           Member    @relation("ThreadOpener", fields: [openedById], references: [id])
  messages           Message[]

  @@index([familyId, lastMessageAt])
  @@index([entityId])
  @@map("threads")
}

model Message {
  id       String @id @default(cuid())
  threadId String @map("thread_id")
  familyId String @map("family_id")

  // Même distinction que sur un récit, et pour la même raison : dans un fil
  // écrit, le clavier rapide parle à la place de celui qui se souvient. Sans
  // `narratorId`, une interface de conversation amplifie exactement la
  // distorsion que le Conservateur mesure.
  authorId   String  @map("author_id")
  narratorId String? @map("narrator_id")

  body String

  // Vingt secondes de voix valent mieux qu'un paragraphe que Jeanne
  // n'écrira pas. L'audio est une Archive, comme le reste.
  archiveId String? @map("archive_id")

  // Un fil ouvert par une question et resté seul est le vide informationnel
  // le plus pur du produit : c'est ce que le Passeur va chercher.
  isQuestion Boolean @default(false) @map("is_question")

  createdAt DateTime @default(now()) @map("created_at")

  thread   Thread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  family   Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author   Member        @relation("MessageAuthor", fields: [authorId], references: [id])
  narrator Member?       @relation("MessageNarrator", fields: [narratorId], references: [id])
  archive  Archive?      @relation(fields: [archiveId], references: [id])
  marks    MessageMark[]

  @@index([threadId, createdAt])
  @@index([familyId])
  @@map("messages")
}

// Ce qui remplace le « j'aime ».
//
// Un compteur de pouces est un score, et le Conservateur existe pour
// combattre les scores. Mais la réaction est la contribution la moins chère
// qui existe — la seule qu'un enfant de sept ans et une femme de
// quatre-vingt-douze ans font aussi facilement l'un que l'autre.
//
// On garde le geste et on jette le jugement : ces marques sont
// INFORMATIVES, pas évaluatives. « J'y étais » n'est pas un avis, c'est un
// fait — et c'est précisément le fait que le Passeur devinait faute de
// mieux. Aucune n'est comptée ni classée : on affiche des noms.
model MessageMark {
  id        String @id @default(cuid())
  messageId String @map("message_id")
  memberId  String @map("member_id")

  // WITNESS « j'y étais » · REMEMBER « je m'en souviens » · LEARNED « je ne savais pas »
  kind String

  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, kind])
  @@map("message_marks")
}

// ─── PASSAGE (lien de transmission entre histoires) ───
model Passage {
  id            String @id @default(cuid())
  familyId      String @map("family_id")
  parentStoryId String @map("parent_story_id")
  childStoryId  String @map("child_story_id")

  triggerType String @map("trigger_type") // question, tradition, temporal, passeur, manual

  latencyDays Int      @map("latency_days")
  createdAt   DateTime @default(now()) @map("created_at")

  family      Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parentStory Story  @relation("ParentStory", fields: [parentStoryId], references: [id])
  childStory  Story  @relation("ChildStory", fields: [childStoryId], references: [id])

  @@unique([parentStoryId, childStoryId])
  @@index([familyId])
  @@map("passages")
}

// ─── BROUILLON DE TRANSCRIPTION ───
//
// Whisper est un modèle génératif : il n'entend pas des mots, il prédit la
// suite la plus probable. Sur un silence, une respiration, une hésitation,
// il ne rend pas du vide — il rend ce qui vient statistiquement ensuite.
// Il invente donc, et le fait le plus sur les voix âgées, hésitantes : le
// profil exact de ceux pour qui cette fonction existe.
//
// D'où ce modèle séparé. Une transcription n'est PAS un récit. Elle attend
// dans un brouillon jusqu'à ce qu'un membre ait écouté et validé. Tant
// qu'elle n'est pas validée, elle ne compte dans aucune métrique, n'apparaît
// ni dans la veillée ni chez le Passeur, et n'existe pas pour la famille.
//
// L'audio reste l'original. Le texte n'en est qu'une copie contestable.
model TranscriptionDraft {
  id            String @id @default(cuid())
  familyId      String @map("family_id")
  archiveId     String @unique @map("archive_id")
  requestedById String @map("requested_by_id")

  // pending → ready → validated | discarded ; failed en cas d'erreur
  status String @default("pending")

  // Texte brut tel que rendu par le modèle, JAMAIS retouché.
  // Conservé même après validation : il permet de comparer ce que la
  // machine a proposé à ce que la famille a retenu.
  rawText String? @map("raw_text")

  // Segments horodatés + indicateurs de doute du modèle lui-même.
  segments Json?

  model           String?
  durationSeconds Float?  @map("duration_seconds")

  // D'où vient la transcription : 'local' (navigateur, coût nul) ou 'api'.
  source String @default("api")

  // Second avis. Deux modèles indépendants n'inventent pratiquement jamais
  // la même chose : là où ils coïncident le texte est très probablement
  // juste, là où ils divergent il faut écouter. C'est le levier de précision
  // le plus fort dont on dispose.
  secondText   String? @map("second_text")
  secondSource String? @map("second_source")
  secondModel  String? @map("second_model")
  suspectCount Int     @default(0) @map("suspect_count")
  error        String?

  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  validatedById String?   @map("validated_by_id")
  validatedAt   DateTime? @map("validated_at")
  storyId       String?   @unique @map("story_id")

  archive     Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  requestedBy Member  @relation("Requester", fields: [requestedById], references: [id])
  validatedBy Member? @relation("Validator", fields: [validatedById], references: [id])
  story       Story?  @relation(fields: [storyId], references: [id])

  @@index([familyId, status])
  @@map("transcription_drafts")
}

// ─── MISE EN SOURDINE (quarantaine, par membre) ───
//
// Trois refus d'Emma ne doivent pas faire taire un récit pour Jeanne.
// La quarantaine est donc portée par le couple (récit, membre), et non
// par le récit seul. Réversible à tout moment.
model StoryMute {
  id       String @id @default(cuid())
  familyId String @map("family_id")
  storyId  String @map("story_id")
  memberId String @map("member_id")

  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  story  Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([storyId, memberId])
  @@index([familyId, memberId])
  @@map("story_mutes")
}

// ─── VISIBILITY LOG (audit Conservateur) ───
model VisibilityLog {
  id       String @id @default(cuid())
  familyId String @map("family_id")
  storyId  String @map("story_id")
  memberId String @map("member_id")

  shownAt   DateTime @default(now()) @map("shown_at")
  context   String // home, passeur, search, tradition, graph
  dismissed Boolean  @default(false)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  story  Story  @relation(fields: [storyId], references: [id])

  @@index([familyId, shownAt])
  @@map("visibility_logs")
}
