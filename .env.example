# ─── Base de données (obligatoire) ───
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/heritage?schema=public"

# ─── Redis (optionnel) ───
# Sans REDIS_URL, l'app bascule sur un store mémoire (dev / test uniquement).
# En production, Upstash ou tout Redis 7+ managé.
REDIS_URL=""

# ─── OpenAI (optionnel) ───
# Sans clé, le LLMOperatorService renvoie ses fallbacks déterministes :
# l'app reste entièrement fonctionnelle, sans classification ni extraction automatique.
OPENAI_API_KEY=""

# ─── Accès familial (§4.1) ───
# V1 : l'URL est le secret partagé. Ce jeton est posé en cookie HttpOnly.
FAMILY_TOKEN_SECRET="change-moi-en-production"

# ─── Stockage des archives ───
# Répertoire où sont écrites les photos et les enregistrements.
# Les fichiers ne sont jamais servis directement : ils passent par une
# route authentifiée qui vérifie la famille.
# Sur un hébergement au système de fichiers éphémère (Vercel), brancher
# un pilote S3/R2 sur l'interface de src/lib/storage.ts.
STORAGE_DIR=""

# Stockage objet (S3 / Cloudflare R2). Dès que STORAGE_S3_BUCKET est
# renseigné, il remplace le disque. Indispensable sur un hébergement au
# système de fichiers éphémère : sinon les photos disparaissent au
# redéploiement.
# Le bucket ne doit PAS être public : les fichiers sont servis par une
# route authentifiée, jamais par une URL directe.
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
