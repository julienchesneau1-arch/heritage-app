# ─── Base de données (obligatoire) ───
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/heritage?schema=public"

# ─── Redis (optionnel) ───
# Sans REDIS_URL, l'app bascule sur un store mémoire (dev / test uniquement).
# En production, Upstash ou tout Redis 7+ managé.
REDIS_URL=""

# ─── OpenAI (optionnel) ───
# Sans clé, le LLMOperatorService renvoie ses fallbacks déterministes :
# l'app reste entièrement fonctionnelle, sans classification ni extraction automatique.
OPENAI_API_KEY=""

# ─── Accès familial (§4.1) ───
# V1 : l'URL est le secret partagé. Ce jeton est posé en cookie HttpOnly.
FAMILY_TOKEN_SECRET="change-moi-en-production"

# ─── Stockage archives (optionnel, S3/R2) ───
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
