# Jarvis — variables d'environnement
#
# Copier vers .env et renseigner. Le fichier .env est ignoré par git (03 §9).
# Aucun secret ne doit jamais être commité, ni apparaître dans un prompt,
# un log ou le contexte d'un modèle.

# Environnement actif : dev | test | lab | production
JARVIS_ENV=dev

# --- Base de données ---------------------------------------------------------
# Rôle applicatif. N'a PAS le droit d'UPDATE/DELETE sur le journal (ADR-012).
JARVIS_DB_HOST=localhost
JARVIS_DB_PORT=5432
JARVIS_DB_NAME=jarvis_dev
JARVIS_DB_USER=jarvis_app
JARVIS_DB_PASSWORD=

# Rôle propriétaire, utilisé uniquement par les migrations.
JARVIS_DB_OWNER_USER=jarvis_owner
JARVIS_DB_OWNER_PASSWORD=

# Rôle superutilisateur, utilisé uniquement par `pnpm db:bootstrap`.
JARVIS_DB_SUPERUSER=postgres
JARVIS_DB_SUPERUSER_PASSWORD=

# --- Budget cloud (04 §9) ----------------------------------------------------
# Défaut 0 €. Aucun dépassement silencieux.
JARVIS_CLOUD_BUDGET_MONTHLY_EUR=0

# --- Agenda Google (ADR-078) -------------------------------------------------
#
# ⚠ CES TROIS LIGNES MANQUAIENT À CE FICHIER depuis ADR-078. L'adaptateur
# existait, `googleAgendaConfigure` les cherchait au coffre, et le seul endroit
# censé dire QUOI remplir ne les nommait pas. Une capacité que rien n'annonce
# est, du siège de l'utilisateur, une capacité absente (ADR-094).
#
# Sans elles, `calendar_read` et `calendar_create` répondent « aucun agenda
# connecté » — un prérequis, pas une panne. Rien d'autre ne change.
#
# OÙ LES OBTENIR
# --------------
#   1. https://console.cloud.google.com/apis/credentials
#      → « Créer des identifiants » → « ID client OAuth »
#      → Type : « Application de bureau »
#      Cela donne l'ID client et la clé client.
#
#   2. Activer l'API Agenda pour ce projet :
#      https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
#
#   3. Le jeton de rafraîchissement s'obtient par un échange OAuth. Jarvis a
#      un assistant pour ça, qui tourne SUR TA MACHINE :
#
#          pnpm google:connecter
#
#      Il ouvre la page de consentement Google, récupère le jeton, et l'écrit
#      ICI. Il ne l'affiche jamais à l'écran — un jeton dans l'historique du
#      terminal est un jeton qui traîne.
#
# ⚠ PORTÉE DEMANDÉE : `calendar` seulement. Pas Gmail, pas Drive, pas Contacts.
#    Un jeton porte ce qu'on lui a accordé ; accorder large « au cas où » est
#    la manière la plus simple de perdre plus qu'on ne voulait.
#
# ⚠ ET CES VALEURS NE SORTENT JAMAIS DE CETTE MACHINE. Ni dans un message, ni
#    dans une conversation avec un modèle, ni dans une capture d'écran.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Passerelle web locale (ADR-023, 03 §14) ---------------------------------
# Jeton exigé sur chaque appel de données de `pnpm jarvis:web`. 32 caractères
# minimum ; `pnpm jarvis:setup` en génère un de 256 bits. Sans lui, le serveur
# refuse de démarrer — c'est la seule barrière entre le Wi-Fi et la mémoire.
JARVIS_WEB_TOKEN=

# Optionnels. Par défaut : première adresse privée de la machine, port 7375.
# JARVIS_WEB_HOST=192.168.1.20
# JARVIS_WEB_PORT=7375

# Ouvre Jarvis hors du réseau local. Refusé sans cette ligne, et signalé à
# chaque démarrage. Ne pas activer sans avoir lu 03 §14.
# JARVIS_WEB_ALLOW_PUBLIC=yes
